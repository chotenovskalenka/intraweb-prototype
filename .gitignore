# Screenshoty produkčního intrawebu — obsahují osobní údaje (jména dětí, e-maily rodičů).
# Zůstávají jen lokálně, do gitu nepatří. Viz decision-log „Revize dle reality".
screenshots/
podklady/

# .claude je ignorovaný globálně (~/.gitignore_global). Výjimka jen pro skill „vhaaji",
# ať cestuje s repem; lokální settings.local.json / launch.json zůstávají mimo git.
!.claude/
.claude/*
!.claude/skills/

# Přepisy hloubkových rozhovorů — obsahují jména respondentů (osobní údaje).
# Zůstávají jen lokálně, stejný režim jako podklady/.
discovery/přepisy/
# Nezávislý AI průchod přepisy — obsahuje citáty respondentů (osobní údaje).
discovery/validace/
